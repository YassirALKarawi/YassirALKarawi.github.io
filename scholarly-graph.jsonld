    {
      "@type": "ScholarlyArticle",
      "@id": "https://yassiralkarawi.github.io/research/propagation-models-lte-advanced.html#article",
      "headline": "Studying Different Propagation Models for LTE-A System",
      "name": "Studying Different Propagation Models for LTE-A System",
      "description": "A comparative study of radio-propagation models used to characterize coverage and performance in LTE-Advanced systems. This paper compares propagation models for LTE-Advanced systems. The topic concerns how radio-channel modelling informs estimates of path loss, coverage and network performance. It provides a propagation-focused counterpart to the author's work on spectrum coexistence and later mobile-network resource optimisation.",
      "datePublished": "2012",
      "dateModified": "2026-09-07",
